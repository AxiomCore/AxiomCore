// Deliberately unsafe strict fixture. It should fail with AXSEC-001.
module axiom.examples.security_mode_v1_unsafe

project { id = "security-mode-v1-unsafe" version = "v0.1.0" }
variants { ["default"] { include = Listing { "*" } } }
models { ["Note"] = ModelDef { name = "Note" fields = Mapping { ["id"] = ModelField { name = "id" typeRef = TypeRefPrimitive { kind = "string" } } } } }
endpoints {
  ["GetNote"] = EndpointDef { id = 1 name = "get_note" method = "GET" path = "/notes/{id}" returnType = TypeRefNamed { value = "Note" } }
}
security { mode = "strict" }
