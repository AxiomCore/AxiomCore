module axiom.examples.domain_support

project {
  id = "domain-support"
  version = "v1.0.0"
}

variants { ["default"] { include = Listing { "*" } } }

models {
  ["SupportTicket"] = ModelDef {
    name = "SupportTicket"
    fields = Mapping {
      ["id"] = ModelField { name = "id" typeRef = TypeRefPrimitive { kind = "string" } }
      ["customerId"] = ModelField { name = "customerId" typeRef = TypeRefPrimitive { kind = "string" } }
      ["subject"] = ModelField { name = "subject" typeRef = TypeRefPrimitive { kind = "string" } }
      ["status"] = ModelField { name = "status" typeRef = TypeRefPrimitive { kind = "string" } }
    }
  }
  ["SupportCustomer"] = ModelDef {
    name = "SupportCustomer"
    fields = Mapping {
      ["id"] = ModelField { name = "id" typeRef = TypeRefPrimitive { kind = "string" } }
      ["displayName"] = ModelField { name = "displayName" typeRef = TypeRefPrimitive { kind = "string" } }
      ["plan"] = ModelField { name = "plan" typeRef = TypeRefPrimitive { kind = "string" } }
    }
  }
}

hidden Models = {
  SupportTicket = TypeRefNamed { value = "SupportTicket" }
  SupportCustomer = TypeRefNamed { value = "SupportCustomer" }
}

Entities = Entities {
  ticket = extend Models.SupportTicket
  customer = extend Models.SupportCustomer
}

domain {
  entities = Entities
  relationships = Relationships {
    ["ticketCustomer"] = DomainRelationship { from = Entities.ticket to = Entities.customer via = "customerId" required = true }
  }
  invariants = Invariants {
    ["ticketSubjectRequired"] = DomainInvariant { scope = Entities.ticket expression = "subject.trim().length > 0" fields = Listing { "subject" } }
  }
  projections = Projections {
    ["agentTicket"] = DomainProjection { entity = Entities.ticket fields = Listing { "id" "subject" "status" } audience = "support-agent" }
  }
}

endpoints {
  ["get_ticket"] = EndpointDef {
    id = 1
    name = "get_ticket"
    method = "GET"
    path = "/tickets/{id}"
    returnType = Entities.ticket
    responseProjection = "agentTicket"
    parameters = Listing { EndpointParameter { name = "id" source = "path" typeRef = TypeRefPrimitive { kind = "string" } } }
  }
}
