amends "axiom-fastapi:./test_server.py:app"

local Routes = module.Routes

project {
  id = "streaming-test"
  version = "1.0.0"
}

variants {
  ["default"] {
    include = List("*")
  }
}

endpoints {

  // Define the WebSocket message schema (Since Python @app.websocket is opaque)
  [Routes.websocket_endpoint] {
    streaming = WebSocketDef {
      direction = "bidirectional"
      reconnect = "auto"

      serverMessages = Listing {
        WsMessageDef {
          type = "chat"
          model = TypeRefNamed { value = "ChatMessage" }
        }
      }

      clientMessages = Listing {
        WsMessageDef {
          type = "raw"
          model = TypeRefPrimitive { kind = "string" }
        }
      }
    }
  }

  // SSE and Chunks are auto-inferred by the extractor as HttpStream/SSE,
  // but we ensure they map to our ChatMessage model for the SDK.
  [Routes.stream_chunks] {
    streaming = HttpStreamDef {
      responseType = TypeRefNamed { value = "ChatMessage" }
      encoding = "json"
    }
  }

  [Routes.stream_sse] {
    streaming = SseStreamDef {
      responseType = TypeRefNamed { value = "ChatMessage" }
    }
  }
}
