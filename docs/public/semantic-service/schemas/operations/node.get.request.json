{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axiomcore.dev/agent-semantic/v1/operations/node.get.request.json",
  "title": "node.get request",
  "description": "params of node.get: a batch of explicit ids with a projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/nodeId"
      },
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true
    },
    "projection": {
      "description": "Preset. summary: node only. standard (default): properties and edges. full: also body and provenance.",
      "enum": [
        "summary",
        "standard",
        "full"
      ]
    },
    "include": {
      "description": "Adds to the preset.",
      "type": "array",
      "items": {
        "enum": [
          "properties",
          "edges",
          "incoming",
          "body",
          "provenance",
          "edits"
        ]
      },
      "uniqueItems": true
    },
    "limit": {
      "description": "Caps properties and edges per node independently.",
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
