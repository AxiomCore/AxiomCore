{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axiomcore.dev/agent-semantic/v1/operations/change.apply.request.json",
  "title": "change.apply request",
  "description": "params of change.apply (local filesystem publication). Content preconditions default to the candidate's base digests of every file it writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "expected_candidate_version"
  ],
  "properties": {
    "candidate": {
      "$ref": "../common.json#/$defs/candidateId"
    },
    "expected_candidate_version": {
      "type": "integer",
      "minimum": 1
    },
    "preconditions": {
      "description": "Explicit content preconditions (sha256 null: the file must not exist). Must include every written file when given.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "../common.json#/$defs/path"
          },
          "sha256": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "require_checks": {
      "description": "Checks that must have passed on this exact candidate version.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true
    }
  }
}
