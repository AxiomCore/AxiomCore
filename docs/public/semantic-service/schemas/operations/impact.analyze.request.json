{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axiomcore.dev/agent-semantic/v1/operations/impact.analyze.request.json",
  "title": "impact.analyze request",
  "description": "params of impact.analyze (caps from limits).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets",
    "direction"
  ],
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/nodeId"
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "direction": {
      "enum": [
        "dependents",
        "dependencies",
        "both"
      ]
    },
    "edge_kinds": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/edgeKind"
      },
      "uniqueItems": true
    }
  }
}
