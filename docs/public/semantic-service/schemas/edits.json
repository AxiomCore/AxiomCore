{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axiomcore.dev/agent-semantic/v1/edits.json",
  "title": "Edit definitions",
  "description": "Edit operations (change.propose, edit.plan), discovered edit options (node.edits), id maps, relocations, file changes, candidates, checks and evidence.",
  "$defs": {
    "editKind": {
      "description": "Edit family. Each is a change.propose operation kind. replace_region is the fallback capability of syntax snapshots: node.edits offers it only there, and the manifest marks it fallback.",
      "enum": [
        "set_property",
        "bind_property",
        "list_element",
        "declaration",
        "set_reference",
        "import",
        "replace_region"
      ]
    },
    "listElementOp": {
      "enum": [
        "remove",
        "insert"
      ]
    },
    "listPosition": {
      "enum": [
        "before",
        "after"
      ]
    },
    "declarationOp": {
      "enum": [
        "create",
        "update",
        "remove"
      ]
    },
    "declarationPosition": {
      "enum": [
        "before",
        "after",
        "first"
      ]
    },
    "importOp": {
      "enum": [
        "add",
        "remove"
      ]
    },
    "importKind": {
      "enum": [
        "component",
        "model"
      ]
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "nodeTarget": {
      "description": "A node id of the base snapshot, or {handle} naming a node an earlier operation of the same batch created.",
      "anyOf": [
        {
          "$ref": "common.json#/$defs/nodeId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "$ref": "#/$defs/handle"
            }
          }
        }
      ]
    },
    "optionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "fingerprint"
      ],
      "properties": {
        "option_id": {
          "description": "Short handle from node.edits, scoped to its snapshot.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fingerprint": {
          "description": "The option's fingerprint; a mismatch with the current one is precondition_failed (option_stale).",
          "$ref": "common.json#/$defs/fingerprint"
        }
      }
    },
    "editOperation": {
      "description": "One edit. kind (and op, where the family has several) selects the shape.",
      "oneOf": [
        {
          "$ref": "#/$defs/setProperty"
        },
        {
          "$ref": "#/$defs/bindProperty"
        },
        {
          "$ref": "#/$defs/listElementRemove"
        },
        {
          "$ref": "#/$defs/listElementInsert"
        },
        {
          "$ref": "#/$defs/declarationCreate"
        },
        {
          "$ref": "#/$defs/declarationUpdate"
        },
        {
          "$ref": "#/$defs/declarationRemove"
        },
        {
          "$ref": "#/$defs/setReference"
        },
        {
          "$ref": "#/$defs/importAdd"
        },
        {
          "$ref": "#/$defs/importRemove"
        },
        {
          "$ref": "#/$defs/replaceRegion"
        }
      ]
    },
    "setProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "node",
        "property",
        "old_value",
        "new_value"
      ],
      "properties": {
        "kind": {
          "const": "set_property"
        },
        "node": {
          "$ref": "#/$defs/nodeTarget"
        },
        "property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "old_value": {
          "description": "Exact precondition, as node.get returned it.",
          "$ref": "common.json#/$defs/jsonValue"
        },
        "new_value": {
          "$ref": "common.json#/$defs/jsonValue"
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Set one authored literal scalar."
    },
    "bindProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "node",
        "property",
        "old_value",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "bind_property"
        },
        "node": {
          "$ref": "#/$defs/nodeTarget"
        },
        "property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "old_value": {
          "$ref": "common.json#/$defs/jsonValue"
        },
        "target": {
          "description": "A state node of the element's owner.",
          "$ref": "#/$defs/nodeTarget"
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Bind one authored property to a state of the same owner."
    },
    "listElementRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "node",
        "old_text"
      ],
      "properties": {
        "kind": {
          "const": "list_element"
        },
        "op": {
          "const": "remove"
        },
        "node": {
          "$ref": "#/$defs/nodeTarget"
        },
        "old_text": {
          "description": "Exact tight-span text (node.edits option text).",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Remove one element or conditional from a view children list."
    },
    "listElementInsert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "anchor",
        "position",
        "old_text",
        "element"
      ],
      "properties": {
        "kind": {
          "const": "list_element"
        },
        "op": {
          "const": "insert"
        },
        "anchor": {
          "$ref": "#/$defs/nodeTarget"
        },
        "position": {
          "$ref": "#/$defs/listPosition"
        },
        "old_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "element": {
          "description": "Source of one view element, no indentation on its first line.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Insert one view element before or after an anchor."
    },
    "declarationCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "anchor",
        "position",
        "old_text",
        "declaration"
      ],
      "properties": {
        "kind": {
          "const": "declaration"
        },
        "op": {
          "const": "create"
        },
        "anchor": {
          "$ref": "#/$defs/nodeTarget"
        },
        "position": {
          "$ref": "#/$defs/declarationPosition"
        },
        "old_text": {
          "description": "The anchor's tight text, or the owner's header line for position first.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "declaration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Create a state or action in a page or component."
    },
    "declarationUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "node",
        "old_text",
        "declaration"
      ],
      "properties": {
        "kind": {
          "const": "declaration"
        },
        "op": {
          "const": "update"
        },
        "node": {
          "$ref": "#/$defs/nodeTarget"
        },
        "old_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "declaration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Replace a state or action declaration, keeping kind and name."
    },
    "declarationRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "node",
        "old_text"
      ],
      "properties": {
        "kind": {
          "const": "declaration"
        },
        "op": {
          "const": "remove"
        },
        "node": {
          "$ref": "#/$defs/nodeTarget"
        },
        "old_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Remove an unreferenced state or action."
    },
    "setReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "node",
        "property",
        "old_value",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "set_reference"
        },
        "node": {
          "$ref": "#/$defs/nodeTarget"
        },
        "property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "old_value": {
          "description": "The current action identifier.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target": {
          "$ref": "#/$defs/nodeTarget"
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Point an on_* handler at another action of the same owner."
    },
    "importAdd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "path",
        "import_kind",
        "symbol",
        "from"
      ],
      "properties": {
        "kind": {
          "const": "import"
        },
        "op": {
          "const": "add"
        },
        "path": {
          "$ref": "common.json#/$defs/path"
        },
        "import_kind": {
          "$ref": "#/$defs/importKind"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "from": {
          "description": "Relative path of the module that exports symbol.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Add one use line to a file."
    },
    "importRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "path",
        "symbol",
        "old_text"
      ],
      "properties": {
        "kind": {
          "const": "import"
        },
        "op": {
          "const": "remove"
        },
        "path": {
          "$ref": "common.json#/$defs/path"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "old_text": {
          "description": "The exact use line.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "handle": {
          "description": "Names this operation's created node for later operations in the same batch (intra-batch handle).",
          "$ref": "#/$defs/handle"
        },
        "expected_node_version": {
          "description": "Optional precondition: the node's version from node.get or node.edits.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "option": {
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Remove one use line whose symbol the file no longer references."
    },
    "replaceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "start_line",
        "end_line",
        "old_text",
        "new_text",
        "option"
      ],
      "properties": {
        "kind": {
          "const": "replace_region"
        },
        "path": {
          "$ref": "common.json#/$defs/path"
        },
        "start_line": {
          "description": "1-based first line of the region.",
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "description": "1-based last line of the region (inclusive); at most 200 lines in all.",
          "type": "integer",
          "minimum": 1
        },
        "old_text": {
          "description": "The region's exact text (node.edits option region.old_text): lines start_line..=end_line without the last newline.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "new_text": {
          "description": "Replaces exactly the region's bytes; at most 200 lines and 16384 bytes (empty removes the lines' text).",
          "type": "string",
          "maxLength": 16384
        },
        "option": {
          "description": "Required: the region option (option_id r<N> and fingerprint) node.edits offered on this snapshot.",
          "$ref": "#/$defs/optionRef"
        }
      },
      "description": "Fallback: replace the smallest whole-line region around a syntax error, offered by node.edits only on a syntax snapshot. The only operation of its batch (invalid_arguments, region_alone, otherwise); never a whole file."
    },
    "editOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "fingerprint",
        "kind",
        "accepts"
      ],
      "properties": {
        "option_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fingerprint": {
          "description": "SHA-256 over (snapshot id, node version, edit rules identity, canonical option). change.propose rejects a mismatch.",
          "$ref": "common.json#/$defs/fingerprint"
        },
        "kind": {
          "$ref": "#/$defs/editKind"
        },
        "property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accepts": {
          "description": "Type name of the accepted value (String, Int, Float, Bool, Element, Declaration, Action, Import). Open string.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/nodeId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/nodeId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "region": {
          "description": "Kind replace_region only: the region the option replaces, with its exact text and bounds.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "start_line",
            "end_line",
            "old_text",
            "max_lines",
            "max_bytes"
          ],
          "properties": {
            "path": {
              "$ref": "common.json#/$defs/path"
            },
            "start_line": {
              "description": "1-based first line of the region.",
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "description": "1-based last line of the region (inclusive); at most 200 lines in all.",
              "type": "integer",
              "minimum": 1
            },
            "old_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "code": {
              "description": "The diagnostic code of the syntax error inside the region (a syntax-class code, for example AUI401).",
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "max_lines": {
              "type": "integer",
              "minimum": 1
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "description": "One discovered edit, with its option_id and fingerprint. Field rules depend on the kind.",
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "set_property"
              }
            }
          },
          "then": {
            "required": [
              "property"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "states"
                  ]
                },
                {
                  "required": [
                    "targets"
                  ]
                },
                {
                  "required": [
                    "ops"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "bind_property"
              }
            }
          },
          "then": {
            "required": [
              "property",
              "states"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "targets"
                  ]
                },
                {
                  "required": [
                    "ops"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "list_element"
              }
            }
          },
          "then": {
            "required": [
              "ops",
              "text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "property"
                  ]
                },
                {
                  "required": [
                    "states"
                  ]
                },
                {
                  "required": [
                    "targets"
                  ]
                }
              ]
            },
            "properties": {
              "ops": {
                "items": {
                  "$ref": "#/$defs/listElementOp"
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "declaration"
              }
            }
          },
          "then": {
            "required": [
              "ops",
              "text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "property"
                  ]
                },
                {
                  "required": [
                    "states"
                  ]
                },
                {
                  "required": [
                    "targets"
                  ]
                }
              ]
            },
            "properties": {
              "ops": {
                "items": {
                  "$ref": "#/$defs/declarationOp"
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "set_reference"
              }
            }
          },
          "then": {
            "required": [
              "property",
              "targets"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "states"
                  ]
                },
                {
                  "required": [
                    "ops"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "import"
              }
            }
          },
          "then": {
            "required": [
              "ops"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "property"
                  ]
                },
                {
                  "required": [
                    "states"
                  ]
                },
                {
                  "required": [
                    "targets"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            },
            "properties": {
              "ops": {
                "items": {
                  "$ref": "#/$defs/importOp"
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "replace_region"
              }
            }
          },
          "then": {
            "required": [
              "region"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "property"
                  ]
                },
                {
                  "required": [
                    "states"
                  ]
                },
                {
                  "required": [
                    "targets"
                  ]
                },
                {
                  "required": [
                    "ops"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "not": {
                  "const": "replace_region"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "region"
              ]
            }
          }
        }
      ]
    },
    "unavailableEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code",
        "reason"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/editKind"
        },
        "property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "code": {
          "description": "The error code the edit would get.",
          "enum": [
            "unsupported_operation",
            "ambiguous_owner",
            "read_only_origin",
            "precondition_failed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "description": "An edit family that does not apply to the node, and why (opt-in)."
    },
    "idMapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_id",
        "new_id"
      ],
      "properties": {
        "old_id": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/nodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_id": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/nodeId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "old_id null: inserted. new_id null: removed. Never both null; unchanged ids are not listed.",
      "not": {
        "properties": {
          "old_id": {
            "type": "null"
          },
          "new_id": {
            "type": "null"
          }
        }
      }
    },
    "idMap": {
      "description": "Every node id the edit changed (completeness guarantee: an unlisted node keeps its id). [] when none.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/idMapEntry"
      }
    },
    "relocationStatus": {
      "enum": [
        "ok",
        "removed",
        "missing",
        "unresolved"
      ]
    },
    "identityRelation": {
      "enum": [
        "proven",
        "inferred"
      ]
    },
    "relocationBasis": {
      "enum": [
        "id_map",
        "exact",
        "text",
        "path",
        "missing"
      ]
    },
    "relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_id",
        "new_id",
        "status",
        "relation",
        "basis"
      ],
      "properties": {
        "old_id": {
          "$ref": "common.json#/$defs/nodeId"
        },
        "new_id": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/nodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/relocationStatus"
        },
        "relation": {
          "$ref": "#/$defs/identityRelation"
        },
        "basis": {
          "$ref": "#/$defs/relocationBasis"
        }
      },
      "description": "new_id is set exactly when status is ok. basis id_map exactly when relation is proven.",
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "new_id": {
                "$ref": "common.json#/$defs/nodeId"
              }
            }
          },
          "else": {
            "properties": {
              "new_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "relation"
            ],
            "properties": {
              "relation": {
                "const": "proven"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "const": "id_map"
              }
            }
          },
          "else": {
            "properties": {
              "basis": {
                "not": {
                  "const": "id_map"
                }
              }
            }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "content"
      ],
      "properties": {
        "path": {
          "$ref": "common.json#/$defs/path"
        },
        "sha256": {
          "$ref": "common.json#/$defs/sha256"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "change",
        "before_sha256",
        "after_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "common.json#/$defs/path"
        },
        "change": {
          "enum": [
            "modified",
            "created",
            "deleted"
          ]
        },
        "before_sha256": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_sha256": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "description": "Full new content, only when requested (change.inspect include content).",
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "change"
            ],
            "properties": {
              "change": {
                "const": "created"
              }
            }
          },
          "then": {
            "properties": {
              "before_sha256": {
                "type": "null"
              },
              "after_sha256": {
                "$ref": "common.json#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "change"
            ],
            "properties": {
              "change": {
                "const": "deleted"
              }
            }
          },
          "then": {
            "properties": {
              "after_sha256": {
                "type": "null"
              },
              "before_sha256": {
                "$ref": "common.json#/$defs/sha256"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "content"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "change"
            ],
            "properties": {
              "change": {
                "const": "modified"
              }
            }
          },
          "then": {
            "properties": {
              "before_sha256": {
                "$ref": "common.json#/$defs/sha256"
              },
              "after_sha256": {
                "$ref": "common.json#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "dependencyRole": {
      "enum": [
        "ui_lock",
        "contract",
        "deps_manifest",
        "extension_source",
        "stylesheet",
        "asset"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolchain",
        "inputs"
      ],
      "properties": {
        "toolchain": {
          "$ref": "common.json#/$defs/toolchain"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "dependencies",
            "dependencies_fingerprint"
          ],
          "properties": {
            "sources": {
              "$ref": "common.json#/$defs/sha256"
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "role",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "$ref": "common.json#/$defs/path"
                  },
                  "role": {
                    "$ref": "#/$defs/dependencyRole"
                  },
                  "sha256": {
                    "$ref": "common.json#/$defs/sha256"
                  }
                }
              }
            },
            "dependencies_fingerprint": {
              "$ref": "common.json#/$defs/sha256"
            }
          }
        }
      },
      "description": "Evidence of a compile. (compiler_identity, target, sources, dependencies_fingerprint) is the reuse key of a check."
    },
    "candidateState": {
      "enum": [
        "open",
        "applied",
        "discarded",
        "expired"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "state",
        "base_snapshot",
        "snapshot",
        "request_id",
        "input_fingerprint"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/candidateId"
        },
        "version": {
          "description": "Increases with every successful change.propose on the candidate.",
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/candidateState"
        },
        "base_snapshot": {
          "$ref": "common.json#/$defs/snapshotId"
        },
        "snapshot": {
          "description": "Snapshot id of base plus overlay; readable by the owning caller.",
          "$ref": "common.json#/$defs/snapshotId"
        },
        "request_id": {
          "description": "The request_id of the change.propose that produced this version.",
          "$ref": "common.json#/$defs/requestId"
        },
        "input_fingerprint": {
          "$ref": "common.json#/$defs/fingerprint"
        },
        "expires_at": {
          "$ref": "common.json#/$defs/timestamp"
        }
      }
    },
    "checkStatus": {
      "enum": [
        "passed",
        "failed",
        "not_run",
        "unavailable"
      ]
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "status",
        "diagnostics"
      ],
      "properties": {
        "check": {
          "description": "Check profile id from the manifest, for example compile.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "$ref": "#/$defs/checkStatus"
        },
        "diagnostics": {
          "$ref": "common.json#/$defs/diagnostics"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "reason": {
          "description": "Why not_run or unavailable.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "operationOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "kind",
        "id_map"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/editKind"
        },
        "op": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "created_node": {
          "$ref": "common.json#/$defs/nodeId"
        },
        "id_map": {
          "description": "This operation's map, relative to the previous operation's result.",
          "$ref": "#/$defs/idMap"
        }
      }
    },
    "repairOutcome": {
      "description": "How a repair candidate (of a syntax or resolved base) compares with its base. Accepted when result_state is validated or result_errors < base_errors, and no declaration other than the broken ones it touched has more errors.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_state",
        "base_errors",
        "result_state",
        "result_errors",
        "touched"
      ],
      "properties": {
        "base_state": {
          "$ref": "common.json#/$defs/semanticState"
        },
        "base_errors": {
          "type": "integer",
          "minimum": 0
        },
        "result_state": {
          "$ref": "common.json#/$defs/semanticState"
        },
        "result_errors": {
          "type": "integer",
          "minimum": 0
        },
        "touched": {
          "description": "Declarations the candidate changed, as <path>: <kind> <name>.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 50
        },
        "regressed": {
          "description": "In a refusal's details only: declarations that gained errors outside the broken ones the candidate changed.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 50
        }
      }
    }
  }
}
