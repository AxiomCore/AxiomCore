project(id: "docs.exam", version: "1.0.0")
variant default(include: ["*"])

model Access { apiKey: String }
model Empty {}
model Question { id: String prompt: String optionA: String optionB: String } also entity
model Answers {
  attemptId: String(minLength: 1, maxLength: 40, pattern: "^[A-Za-z0-9_-]+$")
  name: String(minLength: 1, maxLength: 80)
  first: String(pattern: "^[AB]$")
  second: String(pattern: "^[AB]$")
}
model Submission { apiKey: String answers: Models.Answers }
model Graded { id: String name: String first: String second: String score: String total: String } also entity
model Problem { message: String }
failure duplicate(payload: Models.Problem, status: 409)
failure unavailable(payload: Models.Problem, status: 503)
failure invalidName(payload: Models.Problem, status: 422)

guard signedIn(kind: GuardKind.authenticated)
serverPolicy local(timeout: 10s, guards: [Guards.signedIn])
serverDefaults(policy: ServerPolicies.local)
cors(origins: ["http://127.0.0.1:5174", "http://localhost:5174"],
  methods: [GET, POST], headers: ["content-type", "apikey", "traceparent", "x-axiom-cache-mode"],
  credentials: false, maxAge: 1m)

resource submissions(lifetime: ProviderLifetime.application) {
  operation list(input: Models.Empty, output: List<Models.Graded>, effect: EffectKind.read)
  operation create(input: Models.Graded, output: Models.Graded, effect: EffectKind.write,
    errors: [Failures.duplicate])
}

pure fn grade(first: String, second: String): String = first == "B" && second == "A" ? "2" : first == "B" || second == "A" ? "1" : "0"

action questions(kind: ActionKind.query, input: Models.Access, output: List<Models.Question>) {
  errors(Failures.unavailable)
  managed {
    return [
      {id: "1", prompt: "Which file contains Acore source?", optionA: ".axiom", optionB: ".acore"},
      {id: "2", prompt: "Which layer should calculate the final score?", optionA: "The backend", optionB: "The browser"}
    ]
  }
}
action submit(kind: ActionKind.command, input: Models.Submission, output: Models.Graded) {
  errors(Failures.duplicate, Failures.invalidName)
  managed {
    let name = Input.answers.name.trim()
    guard name.length > 0 else fail Failures.invalidName({message: "Enter your name"})
    let score = grade(Input.answers.first, Input.answers.second)
    let result = await Resources.submissions.create(input: {
      id: Input.answers.attemptId, name: name,
      first: Input.answers.first, second: Input.answers.second, score: score, total: "2"
    })
    return result
  }
}
action results(kind: ActionKind.query, input: Models.Access, output: List<Models.Graded>) {
  errors(Failures.unavailable)
  managed {
    let rows = await Resources.submissions.list(input: {})
    return rows
  }
}
projection questionPublic(entity: Entities.question, fields: [.id, .prompt, .optionA, .optionB], audience: Audience.web)
projection resultPublic(entity: Entities.graded, fields: [.id, .name, .first, .second, .score, .total], audience: Audience.web)

endpoint questions(method: GET, path: "/questions") {
  request { header("apiKey", type: String) }
  handle(action: Actions.questions, input: {apiKey: Input.header.apiKey})
  response(type: List<Models.Question>, projection: Projections.questionPublic)
  errors(Failures.unavailable)
}
endpoint submit(method: POST, path: "/submissions") {
  request { header("apiKey", type: String) body("answers", type: Models.Answers) }
  handle(action: Actions.submit, input: {apiKey: Input.header.apiKey, answers: Input.body.answers})
  response(type: Models.Graded, projection: Projections.resultPublic)
  errors(Failures.duplicate, Failures.invalidName)
  exposeFailure(failure: Failures.duplicate, fields: [.message], audiences: ["web"])
  exposeFailure(failure: Failures.invalidName, fields: [.message], audiences: ["web"])
  invalidates("exam:results")
}
endpoint results(method: GET, path: "/results") {
  request { header("apiKey", type: String) }
  handle(action: Actions.results, input: {apiKey: Input.header.apiKey})
  response(type: List<Models.Graded>, projection: Projections.resultPublic)
  errors(Failures.unavailable)
  cacheIdentity("exam:results")
}
