amends "axiom-fastapi:./test_server.py:app"

local Routes = module.Routes

project {
  id = "auth-obs-test"
  version = "1.0.0"
}

variants {
  ["default"] { // Changed from "mobile"
    include = List("*")
  }
}

// Runtime observability
observability {
  enabled = true
  // Example Jaeger local OTLP collector
  telemetryUrl = "http://localhost:4318/v1/traces"
  sampleRate = 1.0
}

// Authentication rules
endpoints {

  // 1. JWT with Scopes
  [Routes.protected_jwt] {
    auth = EndpointAuth {
      required = true
      scopes = Listing { "items:read" }
      methods = Listing {
        AuthMethodDef {
          type = "bearer";
          name = "Authorization";
          scheme = "Bearer";
          location = "header";
          // VALIDATED LOCALLY IN RUST!
          validation = AuthValidationDef {
            strategy = "jwt";
            // Fixture-only placeholder. Production validation material belongs
            // in a runtime secret provider, not a committed contract.
            secret = "development-only-placeholder";
            alg = "HS256"
          }
        }
      }
    }
  }

  // 2. API Key Header
  [Routes.protected_api_key_header] {
    auth = EndpointAuth {
      required = true
      methods = Listing {
        AuthMethodDef {
          type = "api_key";
          name = "x-api-key";
          location = "header"
        }
      }
    }
  }

  // 3. API Key Query
  [Routes.protected_api_key_query] {
    auth = EndpointAuth {
      required = true
      methods = Listing {
        AuthMethodDef {
          type = "api_key";
          name = "api_key";
          location = "query"
        }
      }
    }
  }

  // 4. Multi Auth (OR Condition)
  [Routes.protected_multi] {
    auth = EndpointAuth {
      required = true
      condition = "or" // Only needs ONE of these to pass
      methods = Listing {
        AuthMethodDef { type = "bearer"; name = "Authorization"; location = "header" };
        AuthMethodDef { type = "api_key"; name = "x-api-key"; location = "header" }
      }
    }
  }
}
