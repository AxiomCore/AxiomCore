{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "next build",
    "check": "pnpm lint:content && pnpm types:check && pnpm build && pnpm release:manifest && pnpm test:routes",
    "dev": "next dev",
    "lint:content": "node scripts/validate-content.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "static:build": "node scripts/build-cloudflare-static.mjs",
    "static:check": "pnpm lint:content && pnpm types:check && pnpm static:build",
    "start": "next start",
    "test:routes": "node scripts/smoke-built-site.mjs",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "fumadocs-core": "16.6.3",
    "fumadocs-mdx": "14.2.7",
    "fumadocs-ui": "^16.6.3",
    "lucide-react": "^0.570.0",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wrangler": "4.132.0"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
